{
  "dashboard": {
    "title": "ProxyMesh Gateway",
    "uid": "proxymesh-gateway",
    "timezone": "UTC",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(proxymesh_requests_total[5m])",
            "legendFormat": "{{method}} {{path}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"unit": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Success Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(proxymesh_requests_total{status=~\"2..\"}[5m]) / rate(proxymesh_requests_total[5m]) * 100",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"unit": "percent", "min": 0, "max": 100},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Latency (p95)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(proxymesh_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"unit": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Rate Limited Requests",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(proxymesh_rate_limited_total[5m])",
            "legendFormat": "Rate Limited",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"unit": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Active Nodes",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 16, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "proxymesh_capacity_total_nodes",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0
          }
        }
      },
      {
        "id": 6,
        "title": "Healthy Nodes",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 16, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "proxymesh_capacity_healthy_nodes",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {"mode": "thresholds"}
          },
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 3},
              {"color": "green", "value": 5}
            ]
          }
        }
      },
      {
        "id": 7,
        "title": "Critical Nodes",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 16, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "proxymesh_capacity_critical_nodes",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {"mode": "thresholds"}
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 3}
            ]
          }
        }
      },
      {
        "id": 8,
        "title": "WebSocket Connections",
        "type": "graph",
        "gridPos": {"x": 18, "y": 16, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "proxymesh_websocket_connections",
            "legendFormat": "Connections",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"unit": "short", "min": 0},
          {"format": "short"}
        ]
      }
    ]
  }
}
